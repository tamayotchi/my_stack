defmodule <%= base %>.Storage.R2Test do
  use ExUnit.Case, async: false

  alias <%= base %>.Storage.R2

  setup do
    storage = Application.fetch_env!(<%= app %>, :storage)
    req_opts = Application.fetch_env(:ex_aws, :req_opts)

    Application.put_env(<%= app %>, :storage,
      adapter: R2,
      bucket: "test-bucket",
      endpoint: "https://objects.example.test:8443",
      region: "auto",
      access_key_id: "test-access-key",
      secret_access_key: "test-secret-key"
    )

    on_exit(fn ->
      Application.put_env(<%= app %>, :storage, storage)

      case req_opts do
        {:ok, opts} -> Application.put_env(:ex_aws, :req_opts, opts)
        :error -> Application.delete_env(:ex_aws, :req_opts)
      end
    end)

    :ok
  end

  test "put sends a signed request with the exact binary body and MIME type" do
    stub(fn request ->
      assert request.method == :put
      assert request.url.host == "objects.example.test"
      assert request.url.port == 8443
      assert request.url.path == "/test-bucket/documents/example.txt"
      assert request.body == "hello"
      assert Req.Request.get_header(request, "content-type") == ["text/plain"]
      assert Req.Request.get_header(request, "content-length") == ["5"]
      assert ["AWS4-HMAC-SHA256 " <> _] = Req.Request.get_header(request, "authorization")
      {request, Req.Response.new(status: 200, body: "")}
    end)

    assert :ok = R2.put_object(%{key: "documents/example.txt", body: "hello", content_type: "text/plain"})
  end

  test "delete sends an object request and normalizes success" do
    stub(fn request ->
      assert request.method == :delete
      assert request.url.path == "/test-bucket/documents/example.txt"
      {request, Req.Response.new(status: 204, body: "")}
    end)

    assert :ok = R2.delete_object(%{key: "documents/example.txt"})
  end

  test "propagates service errors" do
    stub(fn request ->
      {request, Req.Response.new(status: 403, body: "<Error><Code>AccessDenied</Code></Error>")}
    end)

    assert {:error, _reason} = R2.delete_object(%{key: "private.txt"})
  end

  # Replace Req's transport, not the storage adapter: no network or credentials needed.
  defp stub(adapter), do: Application.put_env(:ex_aws, :req_opts, adapter: adapter)
end
