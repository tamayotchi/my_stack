# Generated by tamayotchi_stack R2; owned by your application.
defmodule <%= base %>.Storage.R2 do
  @moduledoc "Cloudflare R2 object storage using ExAws.S3 and Req."
  @behaviour <%= base %>.Storage

  @impl true
  def put_object(%{key: key, body: body, content_type: content_type}) do
    {bucket, request_config} = r2_config()

    bucket
    |> ExAws.S3.put_object(key, body,
      content_type: content_type,
      content_length: body |> byte_size() |> Integer.to_string()
    )
    |> ExAws.request(request_config)
    |> normalize_response()
  end

  @impl true
  def delete_object(%{key: key}) do
    {bucket, request_config} = r2_config()

    bucket
    |> ExAws.S3.delete_object(key)
    |> ExAws.request(request_config)
    |> normalize_response()
  end

  defp r2_config do
    config = Application.fetch_env!(<%= app %>, :storage)
    uri = URI.parse(Keyword.fetch!(config, :endpoint))

    # Request-local credentials avoid changing other ExAws/S3 integrations.
    request_config = [
      access_key_id: Keyword.fetch!(config, :access_key_id),
      secret_access_key: Keyword.fetch!(config, :secret_access_key),
      security_token: nil,
      region: Keyword.fetch!(config, :region),
      scheme: "#{uri.scheme}://",
      host: uri.host,
      port: uri.port,
      http_client: ExAws.Request.Req,
      json_codec: Jason
    ]

    {Keyword.fetch!(config, :bucket), request_config}
  end

  defp normalize_response({:ok, _response}), do: :ok
  defp normalize_response({:error, reason}), do: {:error, reason}
end
