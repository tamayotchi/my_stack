# Generated by tamayotchi_stack R2; owned by your application.
defmodule <%= base %>.StorageTest do
  use ExUnit.Case, async: true

  alias <%= base %>.Storage
  alias <%= base %>.Storage.Fake

  setup do
    Fake.reset()
    :ok
  end

  test "stores and deletes generic objects through the configured adapter" do
    attrs = %{key: "documents/example.txt", body: "hello", content_type: "text/plain"}
    assert :ok = Storage.put_object(attrs)
    assert :ok = Storage.delete_object(%{key: attrs.key})
    assert Fake.calls() == [{:put_object, attrs}, {:delete_object, %{key: attrs.key}}]
  end

  test "fake state is isolated between processes" do
    Fake.delete_object_result({:error, :denied})

    task = Task.async(fn ->
      assert Fake.calls() == []
      assert :ok = Storage.delete_object(%{key: "isolated.txt"})
    end)

    Task.await(task)
    assert Fake.calls() == []
    assert {:error, :denied} = Storage.delete_object(%{key: "isolated.txt"})
  end

  test "propagates storage failures" do
    Fake.put_object_result({:error, :unavailable})
    Fake.delete_object_result({:error, :denied})

    assert {:error, :unavailable} =
             Storage.put_object(%{key: "anything", body: "", content_type: "application/octet-stream"})

    assert {:error, :denied} = Storage.delete_object(%{key: "anything"})
  end
end
