# Generated by tamayotchi_stack R2; owned by your application.
import Config

# Respect an explicitly configured alternative backend (e.g. Storage.S3).
tamayotchi_r2_storage = Application.get_env(<%= app %>, :storage, [])

if Keyword.get(tamayotchi_r2_storage, :adapter, <%= base %>.Storage.R2) == <%= base %>.Storage.R2 do
  env = fn name ->
    case System.get_env(name) do
      value when value in [nil, ""] -> nil
      value -> value
    end
  end

  use_r2? =
    config_env() == :prod or
      (config_env() == :dev and
         Enum.any?(["R2_ACCOUNT_ID", "R2_ENDPOINT", "R2_ACCESS_KEY_ID", "R2_SECRET_ACCESS_KEY"], env))

  if use_r2? do
    required = fn name ->
      env.(name) || raise "R2 storage requires #{name}; set it in the runtime environment"
    end

    endpoint =
      env.("R2_ENDPOINT") ||
        "https://#{required.("R2_ACCOUNT_ID")}.r2.cloudflarestorage.com"

    uri = URI.parse(endpoint)

    unless uri.scheme == "https" and is_binary(uri.host) and uri.host != "" and
             uri.path in [nil, "", "/"] and is_nil(uri.query) and is_nil(uri.fragment) and
             is_nil(uri.userinfo) do
      raise "R2_ENDPOINT must be an HTTPS origin without a path, credentials, query, or fragment"
    end

    config <%= app %>, :storage,
      adapter: <%= base %>.Storage.R2,
      bucket: required.("R2_BUCKET"),
      endpoint: endpoint,
      region: env.("R2_REGION") || "auto",
      access_key_id: required.("R2_ACCESS_KEY_ID"),
      secret_access_key: required.("R2_SECRET_ACCESS_KEY"),
      public_base_url: env.("R2_PUBLIC_BASE_URL")
  else
    # Never access R2 in tests, even when the developer has real credentials.
    config <%= app %>, :storage, adapter: <%= base %>.Storage.Fake
  end
end
