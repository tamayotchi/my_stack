# Pinned amd64 binaries, matching this deployment's builder architecture.
# Update URLs and SHA256 digests together after reviewing upstream releases.
RUN test "$(dpkg --print-architecture)" = amd64 \
  && apt-get update \
  && apt-get install -y --no-install-recommends curl util-linux \
  && curl --fail --show-error --location --retry 3 \
    https://github.com/benbjohnson/litestream/releases/download/v0.5.17/litestream-0.5.17-linux-x86_64.tar.gz \
    -o /tmp/litestream.tar.gz \
  && echo "cfb371176d164437ae869f8351cfde49bd1804ae71c61923f75c9cba9c9c006d  /tmp/litestream.tar.gz" | sha256sum -c - \
  && tar -C /usr/local/bin -xzf /tmp/litestream.tar.gz litestream \
  && curl --fail --show-error --location --retry 3 \
    https://github.com/aptible/supercronic/releases/download/v0.2.49/supercronic-linux-amd64 \
    -o /usr/local/bin/supercronic \
  && echo "a53ae236602c7338aba3fbaff40bda6300eae3b9fedb8261eb06cfe3724430c1  /usr/local/bin/supercronic" | sha256sum -c - \
  && chmod +x /usr/local/bin/litestream /usr/local/bin/supercronic \
  && rm /tmp/litestream.tar.gz \
  && rm -rf /var/lib/apt/lists/*
