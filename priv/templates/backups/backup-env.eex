#!/bin/sh
# Generated by tamayotchi_stack backups; owned by your application.
# Sourced by the backup scripts; paths are relative to the release, not /etc.
set -eu
umask 077

export DATABASE_PATH="${DATABASE_PATH:-/app/storage/<%= app %>.db}"
export LITESTREAM_BUCKET_NAME="${LITESTREAM_BUCKET_NAME:-<%= slug %>-db-backups}"
export LITESTREAM_BUCKET_PATH="${LITESTREAM_BUCKET_PATH:-<%= slug %>-production-v0.5}"
export LITESTREAM_REGION="${LITESTREAM_REGION:-auto}"
LITESTREAM_CONFIG="${LITESTREAM_CONFIG:-$(dirname "$0")/../etc/litestream.yml}"

for name in LITESTREAM_ENDPOINT LITESTREAM_ACCESS_KEY_ID LITESTREAM_SECRET_ACCESS_KEY; do
  if [ -z "$(printenv "$name" || true)" ]; then
    echo "SQLite backups require $name in the runtime environment" >&2
    exit 1
  fi
done

case "$LITESTREAM_ENDPOINT" in
  https://*) ;;
  *) echo "LITESTREAM_ENDPOINT must use HTTPS" >&2; exit 1 ;;
esac

if [ ! -f "$LITESTREAM_CONFIG" ]; then
  echo "Litestream configuration file is missing" >&2
  exit 1
fi
