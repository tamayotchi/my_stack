#!/bin/sh
# Generated by tamayotchi_stack backups; owned by your application.
set -eu
. "$(dirname "$0")/backup-env"

if [ ! -f "$DATABASE_PATH" ]; then
  echo "SQLite database does not exist; run the application's migrations first" >&2
  exit 1
fi

# The lock is on the shared volume, so manual runs and rolling-deploy containers
# cannot replicate the same database concurrently. Never remove the lock file.
exec 9>"${DATABASE_PATH}.backup.lock"
if ! flock -n 9; then
  echo "Another backup or restore is already running" >&2
  exit 1
fi

echo "Starting SQLite backup at $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
# Unlike a timed sleep, -once exits only after the replication operation.
# A timeout or failed upload is a failed job, never a reported success.
timeout --signal=TERM --kill-after=30s 15m \
  litestream replicate -config "$LITESTREAM_CONFIG" -once -force-snapshot -enforce-retention

echo "SQLite backup completed at $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
