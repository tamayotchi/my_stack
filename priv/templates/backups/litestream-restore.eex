#!/bin/sh
# Generated by tamayotchi_stack backups; owned by your application.
set -eu
. "$(dirname "$0")/backup-env"

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
  echo "Usage: litestream-restore /absolute/new-file.db [RFC3339-timestamp]" >&2
  exit 1
fi

output=$1
case "$output" in
  /*) ;;
  *) echo "Restore destination must be an absolute path" >&2; exit 1 ;;
esac

live=$(readlink -m "$DATABASE_PATH")
destination=$(readlink -m "$output")
metadata="$(dirname "$live")/.$(basename "$live")-litestream"
case "$destination" in
  "$live"|"$live-wal"|"$live-shm"|"$live-journal"|"$live.backup.lock"|"$metadata"|"$metadata"/*)
    echo "Refusing to restore over the live database or its sidecars/metadata; choose a separate file" >&2
    exit 1
    ;;
esac

for path in "$output" "$output-wal" "$output-shm" "$output-journal"; do
  if [ -e "$path" ] || [ -L "$path" ]; then
    echo "Restore destination or SQLite sidecars already exist; choose a new path" >&2
    exit 1
  fi
done

exec 9>"${DATABASE_PATH}.backup.lock"
if ! flock -n 9; then
  echo "Another backup or restore is already running" >&2
  exit 1
fi

# Restore and validate away from both the live DB and the final destination.
work=$(mktemp -d "${output}.restore.XXXXXX")
trap 'rm -rf "$work"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if [ "$#" -eq 2 ]; then
  set -- -timestamp "$2"
else
  set --
fi

timeout --signal=TERM --kill-after=30s 15m \
  litestream restore -config "$LITESTREAM_CONFIG" -integrity-check full \
  -o "$work/restored.db" "$@" "$DATABASE_PATH"

# Atomic no-clobber publication, even if another process creates the destination.
ln "$work/restored.db" "$output"
echo "Backup restored and integrity-checked at $output; the live database was not changed"
